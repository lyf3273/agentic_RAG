# ========================================================
# 1. 大模型 API 核心凭证（必填）
# 只需要一个通义千问 API-Key，即可驱动对话、视觉、精排与向量模型！
# 获取地址: https://bailian.console.aliyun.com/
# ========================================================
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here

# ========================================================
# 2. 模型选型配置（默认全云端 Qwen 架构，开箱即用）
# ========================================================
# 主推理大模型: qwen3.6-flash / qwen-plus / qwen-max
TONGYI_CHAT_MODEL=qwen3.6-flash

# 多模态视觉模型: qwen3-vl-flash / qwen3-vl-plus
TONGYI_VISION_MODEL=qwen3-vl-flash

# 向量嵌入后端选型:
# - dashscope: 推荐！云端一键免装 Ollama，使用 text-embedding-v3 (1024维)
# - ollama: 本地免费离线运行 (需提前执行 ollama pull bge-large-zh-v1.5)
EMBED_BACKEND=dashscope

# 当 EMBED_BACKEND=ollama 时生效:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-large-zh-v1.5

# 精排重排模式: cloud (qwen3-rerank API) / local (本地 CrossEncoder)
RERANK_BACKEND=cloud

# ========================================================
# 3. 存储底座与高可用容灾配置
# ========================================================
# 模式选型:
# - faiss: 默认推荐，纯本地零端口依赖，即配即用
# - remote: 优先连接云端集中式 ChromaDB，若失联超时自动毫秒级降级为本地 FAISS
CHROMA_MODE=faiss

# 当 CHROMA_MODE=remote 时生效。地址只写在本机 .env，不要提交真实 IP。
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_base
CHROMA_TIMEOUT=30
# 运行中失联：每隔几秒重试，最多 5 次，仍失败则降级本地 FAISS
CHROMA_RETRY=5
CHROMA_RETRY_INTERVAL=3
# 后台探活间隔（秒）。降级 FAISS 后仍探活，云端恢复则后台连上再切换
CHROMA_PROBE_INTERVAL=5

# ========================================================
# 4. 检索超参数与切块策略
# ========================================================
VECTOR_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=20
RRF_K=60
RERANK_TOP_N=5

CHILD_MAX_CHARS=1800
PARENT_MAX_CHARS=3500

# ========================================================
# 5. Agent 推理与多模态开关
# ========================================================
MAX_REACT_STEPS=5
KEEP_RECENT_TURNS=3

# 是否开启文档架构图视觉解析 (1=开启, 0=关闭)
RAG_VISION=1
RAG_VISION_MAX_IMAGES=3
RAG_DEBUG=0

# Evidence Studio (python main.py web)
WEB_HOST=127.0.0.1
WEB_PORT=7860
